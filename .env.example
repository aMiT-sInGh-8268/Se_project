# ========================================================
# TaskFlow – Environment Variables Template
# Copy this file to .env and configure values as needed.
# DO NOT commit real secrets or credentials to GitHub!
# ========================================================

# --- Backend Configuration ---
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/taskflow
CORS_ORIGIN=*

# --- Frontend Configuration ---
VITE_API_URL=http://localhost:5000/api

# --- Docker Configuration ---
DOCKER_FRONTEND_PORT=3000
DOCKER_BACKEND_PORT=5000
DOCKER_MONGODB_PORT=27017

# --- Docker Hub / Registry (for CI/CD) ---
# DOCKERHUB_USERNAME=your_dockerhub_username
# DOCKERHUB_TOKEN=your_dockerhub_token

# --- AWS Configuration (for CD deployment) ---
# EC2_HOST=your-ec2-public-ip
# EC2_USERNAME=ubuntu
# EC2_SSH_KEY=your-private-key-pem
